#!/bin/sh
set -e

case "$1" in
    configure)
        # Same as what dh_python3 generates for private modules: byte-compile the
        # package's own files for the default python3. Never fails the install.
        if command -v py3compile >/dev/null 2>&1; then
            py3compile -p salvaguarda /usr/share/salvaguarda >/dev/null 2>&1 || true
        elif command -v python3 >/dev/null 2>&1; then
            python3 -m compileall -q -f /usr/share/salvaguarda >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
