#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure|failed-upgrade)
        if command -v py3clean >/dev/null 2>&1; then
            py3clean -p salvaguarda >/dev/null 2>&1 || true
        fi
        find /usr/share/salvaguarda -depth -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
        ;;
esac

exit 0
